{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downpour",
  "version": "0.2.0",
  "identifier": "com.downpour.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Downpour",
        "width": 1220,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Downpour contributors",
    "copyright": "MIT OR Apache-2.0",
    "category": "Utility",
    "shortDescription": "Cross-platform download manager",
    "longDescription": "Downpour is a fast, open-source download manager with segmented transfers, crash-safe resume, a queue and scheduler, browser take-over, media downloading, and a robots-aware site grabber.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
