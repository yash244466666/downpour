{
  "manifest_version": 3,
  "name": "Downpour",
  "version": "0.0.0",
  "description": "Send browser downloads to Downpour.",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "contextMenus",
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
