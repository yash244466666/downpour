{
  "manifest_version": 3,
  "name": "Downpour",
  "version": "0.0.0",
  "description": "Send browser downloads to Downpour.",
  "browser_specific_settings": {
    "gecko": {
      "id": "downpour@yash244466666.github.io",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "contextMenus",
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["lib.js", "background.js"]
  }
}
